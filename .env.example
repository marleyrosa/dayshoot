# Pagamentos (Vercel > Settings > Environment Variables). NUNCA coloque estes valores no código.
# Token de acesso do Mercado Pago (use o de TESTE primeiro): https://www.mercadopago.com.br/developers/panel
MP_ACCESS_TOKEN=
# URL pública do site, sem barra no final (usada nos retornos do cartão e no webhook)
SITE_URL=https://SEU-DOMINIO
# Opcional: enviar pedidos pagos ao hub (hub/server.js, rota POST /orders)
HUB_ORDERS_URL=https://SEU-HUB/orders
STORE_API_KEY=
# Assinatura secreta do webhook (painel do Mercado Pago > Webhooks). Quando definida, avisos sem assinatura válida são rejeitados.
MP_WEBHOOK_SECRET=
