# Mercado Livre (painel de desenvolvedores: criar aplicação e copiar ID e Secret)
ML_APP_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://SEU-DOMINIO/ml/callback
ML_AUTH_HOST=https://auth.mercadolivre.com.br
# 64 caracteres hex (32 bytes): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENC_KEY=
# Segredo para o site da loja enviar pedidos (header x-api-key)
STORE_API_KEY=
# Opcional: rascunhos de resposta com Claude
ANTHROPIC_API_KEY=
PORT=3000
